  "六神起例": {
    "甲乙": "青龙",
    "丙丁": "朱雀",
    "戊": "勾陈",
    "己": "螣蛇",
    "庚辛": "白虎",
    "壬癸": "玄武",
    "原文": "甲乙起青龙，丙丁起朱雀，戊日起勾陈，己日起螣蛇，庚辛起白虎，壬癸起玄武。",
    "出处": {
      "增删": "增删卜易·起六神诀（原文作靑龍、元武）",
      "正宗": "卜筮正宗·六兽歌"
    }
  },
  "六神顺序": [
    "青龙",
    "朱雀",
    "勾陈",
    "螣蛇",
    "白虎",
    "玄武"
  ],
  "六神起爻": "自初爻起，按六神顺序依次向上排至上爻（据六神章第十八表及六兽起例）。",
  "六亲规则": "生我者为父母，我生者为子孙，克我者为官鬼，我克者为妻财，比和者为兄弟。以卦宫五行为『我』，与各爻地支五行比较定六亲。",
  "六亲出处": "增删卜易·六亲歌章第五（原剑按）；卜筮正宗·启蒙节要",
  "八宫五行": {
    "乾": "金",
    "兑": "金",
    "离": "火",
    "震": "木",
    "巽": "木",
    "坎": "水",
    "坤": "土",
    "艮": "土",
    "出处": "梅花易数·八宫所属五行；卜筮正宗·启蒙节要；增删卜易·六亲歌章第五"
  },
  "安世应": {
    "要领": "八纯卦世在六爻，归魂卦世在三爻，其余因八纯卦变动之爻成卦者，世在变动之爻。应世隔二爻。",
    "歌诀": "乾为天世在六，天风姤世在初，天山遁世在二，天地否世在三，风地观世在四，山地剥世在五，火地晋世在四，火天大有世退在三。隔世爻两位即是应爻。",
    "歌诀正宗": "八卦之首世六当，以下初爻轮上扬。游魂八宫四爻立，归魂八卦三爻详。",
    "出处": {
      "要领": "增删卜易·安世应要领",
      "歌诀": "增删卜易·世应章第六",
      "歌诀正宗": "卜筮正宗·安世应诀"
    }
  },
  "卦身": "阳世则从子月起，阴世还当午月生，此即卦身也。（卦身当一亲）",
  "卦身出处": "火珠林·六亲根源"
}